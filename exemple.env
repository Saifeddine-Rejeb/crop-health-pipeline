# Airflow user mapping for local Docker setup
AIRFLOW_UID=50000

# Databricks connection (replace placeholders with your own values)
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=<your-databricks-token>
DATABRICKS_JOB_ID=<your-job-id>
DATABRICKS_VOLUME_PATH=/Volumes/main/default/crop_health
